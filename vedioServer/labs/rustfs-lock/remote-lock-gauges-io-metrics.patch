+    #[test]
+    fn remote_lock_in_flight_gauges_return_to_zero_after_balanced_transitions() {
+        use metrics_util::debugging::DebugValue;
+
+        let recorder = metrics_util::debugging::DebuggingRecorder::new();
+        let snapshotter = recorder.snapshotter();
+        metrics::with_local_recorder(&recorder, || {
+            increment_remote_lock_rpc_detached_in_flight("http://peer:9000");
+            decrement_remote_lock_rpc_detached_in_flight("http://peer:9000");
+            increment_remote_lock_late_release_in_flight("http://peer:9000");
+            decrement_remote_lock_late_release_in_flight("http://peer:9000");
+        });
+
+        let values = snapshotter
+            .snapshot()
+            .into_vec()
+            .into_iter()
+            .filter_map(|(key, _, _, value)| match value {
+                DebugValue::Gauge(value) => Some((key.key().name().to_string(), value.0)),
+                _ => None,
+            })
+            .collect::<std::collections::HashMap<_, _>>();
+        assert_eq!(values.get("rustfs_remote_lock_rpc_detached_in_flight"), Some(&0.0));
+        assert_eq!(values.get("rustfs_remote_lock_late_release_in_flight"), Some(&0.0));
+    }
