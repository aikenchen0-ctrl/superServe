 type LockAcquireTaskResult = (usize, Result<LockResponse>);
 
+struct LockAcquireAttempt {
+    pending: JoinSet<LockAcquireTaskResult>,
+    individual_locks: Vec<HeldLockEntry>,
+    clients: Arc<[Arc<dyn LockClient>]>,
+    fallback_lock_id: LockId,
+    runtime: tokio::runtime::Handle,
+}
+
+impl Drop for LockAcquireAttempt {
+    fn drop(&mut self) {
+        if self.individual_locks.is_empty() && self.pending.is_empty() {
+            return;
+        }
+
+        // 调用方可能在运行时上下文外丢弃 Future；清理仍交给原运行时。
+        let _entered = self.runtime.enter();
+        DistributedLock::spawn_release_cleanup(
+            self.individual_locks.iter().map(HeldLockEntry::release_entry).collect(),
+            "distributed_lock_acquire_cancelled",
+        );
+        if !self.pending.is_empty() {
+            // 本地取消无法撤销远端授权，保留等待者以回收迟到的成功结果。
+            DistributedLock::spawn_pending_cleanup(
+                std::mem::take(&mut self.pending),
+                self.clients.clone(),
+                self.fallback_lock_id.clone(),
+                "distributed_lock_acquire_cancelled_pending",
+            );
+        }
+    }
+}
