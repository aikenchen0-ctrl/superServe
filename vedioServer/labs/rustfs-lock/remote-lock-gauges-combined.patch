+/// Add a timed-out remote lock RPC to the in-flight gauge for one peer.
+#[inline(always)]
+pub fn increment_remote_lock_rpc_detached_in_flight(peer: &str) {
+    use metrics::gauge;
+    gauge!("rustfs_remote_lock_rpc_detached_in_flight", "peer" => peer.to_string()).increment(1.0);
+}
+
+/// Remove a completed remote lock RPC from the in-flight gauge for one peer.
+#[inline(always)]
+pub fn decrement_remote_lock_rpc_detached_in_flight(peer: &str) {
