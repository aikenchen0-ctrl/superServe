{
  "browser": {
    "browserName": "chromium",
    "launchOptions": {
      "channel": "chrome",
      "headless": true,
      "args": [
        "--autoplay-policy=no-user-gesture-required",
        "--disable-features=WebRtcHideLocalIpsWithMdns"
      ]
    },
    "contextOptions": {
      "viewport": {"width": 1440, "height": 960}
    }
  }
}
