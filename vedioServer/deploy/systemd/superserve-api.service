[Unit]
Description=superServe API pre-production candidate
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
DynamicUser=yes
StateDirectory=superserve-api
StateDirectoryMode=0700
WorkingDirectory=/var/lib/superserve-api
EnvironmentFile=/etc/superserve/api.env
ExecStart=/opt/superserve/current/vs-service
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=40s
SendSIGKILL=yes
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
